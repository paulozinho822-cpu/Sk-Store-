<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#090711">
<title>Sk Store — Loja digital</title>
<style>
:root{--bg:#090711;--panel:#131020;--panel2:#1b1530;--purple:#9b5cff;--purple2:#6e35d4;--text:#f7f3ff;--muted:#aaa1bd;--line:#2c2341;--green:#35d39a}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 75% -10%,#32145b 0,transparent 40%),var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
a{color:inherit;text-decoration:none}.wrap{width:min(1120px,92%);margin:auto}
header{position:sticky;top:0;z-index:10;background:#0b0813eF;border-bottom:1px solid var(--line);backdrop-filter:blur(14px)}
.nav{height:74px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:24px;font-weight:900;letter-spacing:-1px}.brand span{color:var(--purple)}.navlinks{display:flex;gap:24px;color:var(--muted);font-size:14px}.cartbtn,.primary{border:0;border-radius:12px;padding:12px 17px;background:linear-gradient(135deg,var(--purple),var(--purple2));color:white;font-weight:800;cursor:pointer}
.hero{padding:78px 0 56px;display:grid;grid-template-columns:1.15fr .85fr;gap:30px;align-items:center}.eyebrow{color:#c8a7ff;font-size:12px;letter-spacing:2px;text-transform:uppercase;font-weight:800}.hero h1{font-size:clamp(40px,6vw,68px);line-height:.99;letter-spacing:-3px;margin:14px 0}.hero h1 em{font-style:normal;color:#b78aff}.hero p{color:var(--muted);line-height:1.7;max-width:540px}.heroart{min-height:270px;border:1px solid #50347b;border-radius:28px;background:linear-gradient(145deg,#26133e,#110d1d 65%);display:grid;place-items:center;box-shadow:0 25px 80px #4b1a8b33;position:relative;overflow:hidden}.orb{width:190px;height:190px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#e0c6ff,#9a50ff 38%,#3d1474 72%);box-shadow:0 0 90px #a35aff99;display:grid;place-items:center;font-size:54px;font-weight:1000;color:#180c2b}.heroart:after{content:"SK STORE";position:absolute;bottom:22px;letter-spacing:7px;font-size:11px;color:#c8a7ff}
.trust{display:flex;gap:18px;flex-wrap:wrap;margin-top:25px;color:#c7bdd8;font-size:12px}.trust span:before{content:"✓";color:var(--green);font-weight:900;margin-right:7px}
.sectionhead{display:flex;align-items:end;justify-content:space-between;gap:16px;margin:22px 0}.sectionhead h2{font-size:28px;margin:0}.sectionhead p{color:var(--muted);font-size:13px;margin:7px 0 0}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding-bottom:70px}.card{background:linear-gradient(180deg,#171126,#100d19);border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.2s}.card:hover{transform:translateY(-4px);border-color:#8051c8}.productart{height:155px;display:grid;place-items:center;background:radial-gradient(circle at 50% 45%,#5b2d8b,#24143b 55%,#171126);font-size:42px}.productbody{padding:17px}.tag{display:inline-block;background:#2c1b46;color:#cdaeff;padding:5px 9px;border-radius:20px;font-size:10px;font-weight:800}.productbody h3{margin:12px 0 6px;font-size:17px}.desc{color:var(--muted);font-size:12px;line-height:1.5;min-height:36px}.price{font-size:23px;font-weight:900;margin:14px 0}.buy{width:100%;border:1px solid #8250c9;background:#25163b;color:white;border-radius:10px;padding:11px;font-weight:800;cursor:pointer}.buy:hover{background:#42236a}
.info{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:0 0 70px}.info article{border:1px solid var(--line);border-radius:15px;padding:18px;background:#100d19}.info b{display:block;margin:8px 0}.info p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}
footer{border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:12px}.footerrow{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
.overlay{position:fixed;inset:0;background:#000b;z-index:30;display:none;place-items:center;padding:18px}.overlay.open{display:grid}.modal{width:min(480px,100%);background:#151020;border:1px solid #4b356a;border-radius:20px;padding:22px;max-height:90vh;overflow:auto}.modalhead{display:flex;justify-content:space-between;align-items:center}.close{background:none;border:0;color:white;font-size:25px;cursor:pointer}.field{display:block;margin:13px 0;color:#c9bddb;font-size:12px}.field input,.field textarea{display:block;width:100%;margin-top:6px;background:#0b0812;border:1px solid #3b2c51;color:white;border-radius:10px;padding:12px;font:inherit}.notice{background:#241a33;border:1px solid #4b356a;border-radius:10px;padding:12px;color:#d7c9e9;font-size:12px;line-height:1.5}.muted{color:var(--muted);font-size:12px}.total{display:flex;justify-content:space-between;font-weight:900;font-size:19px;margin:18px 0}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:52px}.heroart{min-height:210px}.products{grid-template-columns:1fr 1fr}.info{grid-template-columns:1fr}.navlinks{display:none}}
@media(max-width:480px){.products{grid-template-columns:1fr}.hero h1{letter-spacing:-2px}.sectionhead{align-items:start;flex-direction:column}}
</style>
</head>
<body>
<header><div class="wrap nav"><a class="brand" href="#">SK<span>.</span> STORE</a><nav class="navlinks"><a href="#inicio">Início</a><a href="#catalogo">Catálogo</a><a href="#como-funciona">Como funciona</a></nav><button class="cartbtn" id="cartButton">Carrinho (<span id="cartCount">0</span>)</button></div></header>
<main class="wrap">
<section class="hero" id="inicio"><div><div class="eyebrow">Sua loja digital</div><h1>O próximo nível<br>começa na <em>Sk Store.</em></h1><p>Encontre produtos digitais com uma experiência simples, visual moderno e atendimento direto. Confira o catálogo e tire suas dúvidas antes de comprar.</p><a class="primary" href="#catalogo" style="display:inline-block;margin-top:10px">Explorar catálogo</a><div class="trust"><span>Atendimento humanizado</span><span>Compra acompanhada</span><span>Suporte ao cliente</span></div></div><div class="heroart"><div class="orb">SK</div></div></section>
<section id="catalogo"><div class="sectionhead"><div><h2>Catálogo em destaque</h2><p>Produtos demonstrativos — edite os itens antes de publicar.</p></div><span class="tag">SK STORE</span></div><div class="products" id="products"></div></section>
<section class="info" id="como-funciona"><article><div>✦</div><b>Escolha com atenção</b><p>Leia a descrição e confirme todos os detalhes do produto antes de iniciar o pedido.</p></article><article><div>◈</div><b>Pagamento protegido</b><p>O Pix deve ser gerado por um provedor de pagamento integrado e confirmado pelo próprio provedor.</p></article><article><div>♡</div><b>Fale com a loja</b><p>Inclua seus canais oficiais de suporte e informe claramente as regras de compra e reembolso.</p></article></section>
</main>
<footer><div class="wrap footerrow"><span>© <span id="year"></span> Sk Store. Todos os direitos reservados.</span><span>Loja independente. Não afiliada à Roblox Corporation.</span></div></footer>
<div class="overlay" id="checkout"><div class="modal"><div class="modalhead"><h2 style="margin:0">Finalizar pedido</h2><button class="close" id="closeModal" aria-label="Fechar">×</button></div><div id="cartItems" class="muted" style="margin:16px 0"></div><div class="total"><span>Total</span><span id="total">R$ 0,00</span></div><label class="field">Seu nome<input id="customerName" placeholder="Nome completo"></label><label class="field">E-mail para contato<input id="customerEmail" type="email" placeholder="voce@email.com"></label><div class="notice"><b>Pagamento via Pix</b><br>Esta versão é um modelo visual. Para cobrar de verdade, conecte um gateway (por exemplo, Mercado Pago) no backend. Não envie comprovantes nem dados pessoais por canais não oficiais.</div><button class="primary" id="requestOrder" style="width:100%;margin-top:15px">Preparar pedido</button><p class="muted">Nenhuma cobrança será feita por esta demonstração.</p></div></div>
<script>
const products = [
 {id:1,name:"Produto digital #01",desc:"Adicione aqui uma descrição clara do produto e suas condições.",price:29.90,tag:"DESTAQUE",emoji:"✦"},
 {id:2,name:"Produto digital #02",desc:"Informe exatamente o que está incluído e o que não está incluído.",price:49.90,tag:"POPULAR",emoji:"◈"},
 {id:3,name:"Produto digital #03",desc:"Use imagens próprias e informações verdadeiras no anúncio.",price:19.90,tag:"NOVIDADE",emoji:"✧"}
];
let cart=[];
const money=n=>n.toLocaleString("pt-BR",{style:"currency",currency:"BRL"});
document.getElementById("year").textContent=new Date().getFullYear();
document.getElementById("products").innerHTML=products.map(p=>`<article class="card"><div class="productart">${p.emoji}</div><div class="productbody"><span class="tag">${p.tag}</span><h3>${p.name}</h3><div class="desc">${p.desc}</div><div class="price">${money(p.price)}</div><button class="buy" onclick="addToCart(${p.id})">Adicionar ao carrinho</button></div></article>`).join("");
function addToCart(id){const p=products.find(x=>x.id===id);cart.push(p);document.getElementById("cartCount").textContent=cart.length;document.getElementById("cartButton").animate([{transform:"scale(1)"},{transform:"scale(1.06)"},{transform:"scale(1)"}],{duration:220});}
function openCart(){const box=document.getElementById("cartItems");box.innerHTML=cart.length?cart.map((p,i)=>`<div style="display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid #342745"><span>${p.name}</span><span>${money(p.price)} <button onclick="removeItem(${i})" style="background:none;border:0;color:#cba7ff;cursor:pointer">remover</button></span></div>`).join(""):"Seu carrinho está vazio.";document.getElementById("total").textContent=money(cart.reduce((s,p)=>s+p.price,0));document.getElementById("checkout").classList.add("open");}
function removeItem(i){cart.splice(i,1);document.getElementById("cartCount").textContent=cart.length;openCart();}
document.getElementById("cartButton").addEventListener("click",openCart);
document.getElementById("closeModal").addEventListener("click",()=>document.getElementById("checkout").classList.remove("open"));
document.getElementById("checkout").addEventListener("click",e=>{if(e.target.id==="checkout")e.currentTarget.classList.remove("open")});
document.getElementById("requestOrder").addEventListener("click",()=>{if(!cart.length){alert("Adicione um produto ao carrinho.");return;}const n=document.getElementById("customerName").value.trim(),e=document.getElementById("customerEmail").value.trim();if(!n||!e){alert("Preencha seu nome e e-mail.");return;}alert("Pedido de demonstração preparado. Para receber pagamentos reais, configure um provedor Pix e um backend seguro. Nenhuma cobrança foi realizada.");});
</script>
</body></html>
